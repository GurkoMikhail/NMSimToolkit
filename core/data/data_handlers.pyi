import abc
from typing import Any, Callable, Dict, List, Optional, Set

import h5py
import numpy as np

from core.geometry.volumes import Volume
from core.other.typing_definitions import NDArray, Float, ID, Index

class BaseDataHandler(abc.ABC):
    writer_callback: Optional[Callable]
    def __init__(self) -> None: ...
    def set_writer_callback(self, callback: Callable) -> None: ...
    @abc.abstractmethod
    def process_chunk(self, chunk: Dict[str, Any]) -> None: ...

class DirectStreamHandler(BaseDataHandler):
    def process_chunk(self, chunk: Dict[str, Any]) -> None: ...
    def _write_initial_states(self, initial_states: Dict[str, np.ndarray]) -> None: ...
    def _write_interactions(self, volume_data_map: Dict[str, Dict[str, np.ndarray]]) -> None: ...

class SensitiveVolumeHandler(DirectStreamHandler):
    PROCESS_MAP: Dict[int, bytes]
    sensitive_volumes: List[Volume]
    unique_top_volumes: Set[Volume]
    scene_root: Optional[Volume]
    volume_mapping: Dict[int, Volume]
    target_volumes: List[int]
    def __init__(self, sensitive_volumes: List[Volume]) -> None: ...
    def _build_volume_mapping(self) -> None: ...
    def process_chunk(self, chunk: Dict[str, Any]) -> None: ...
    def _process_interactions(self, interactions: Dict[str, np.ndarray]) -> None: ...
    def _get_volumes_to_write(self) -> List[Volume]: ...
    def _format_and_write_interactions(self, interactions: Dict[str, np.ndarray]) -> None: ...

class HistoryAssemblerHandler(SensitiveVolumeHandler):
    save_initial_states: bool
    initial_states_chunks: List[Dict[str, np.ndarray]]
    interactions_chunks: List[Dict[str, np.ndarray]]
    scored_particles: Set[int]
    def __init__(self, sensitive_volumes: List[Volume], save_initial_states: bool = True) -> None: ...
    def process_chunk(self, chunk: Dict[str, Any]) -> None: ...
    def _get_volumes_to_write(self) -> List[Volume]: ...
    def _flush_dead_particles(self, dead_ids: np.ndarray) -> None: ...

import socket

class LiveTrajectoryHandler(BaseDataHandler):
    max_trajectories: int
    metadata: NDArray[Index]
    step: int
    server_socket: socket.socket
    client_socket: Optional[socket.socket]
    _pos_x: NDArray[Float]
    _pos_y: NDArray[Float]
    _pos_z: NDArray[Float]
    _particle_ids: NDArray[ID]
    _cursor: int

    def __init__(self, port: int, debug_mode: bool, max_trajectories: int = 10000) -> None: ...
    def _accept_client(self) -> None: ...
    def process_chunk(self, chunk: Dict[str, Any]) -> None: ...
